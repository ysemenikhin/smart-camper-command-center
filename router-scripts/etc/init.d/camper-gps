#!/bin/sh /etc/rc.common
# ============================================================
# SMART CAMPER - start-up file for the GPS sender   (v1)
# On the router (GL-X3000):  /etc/init.d/camper-gps
#
# CHANGELOG
#   v1 - 2026-10-21. Runs /usr/bin/camper-gps.sh (v1) as a procd service:
#        starts at boot (START=99, after the network), and if the sender
#        stops (e.g. the modem restarts and the GPS stream disappears) procd
#        starts it again after 10 s, with no limit on retries.
#        Commands:  /etc/init.d/camper-gps enable | start | stop | restart
# ============================================================

START=99
STOP=10
USE_PROCD=1

start_service() {
    procd_open_instance
    procd_set_param command /usr/bin/camper-gps.sh
    # respawn <reset counter after s> <wait before restart s> <max tries, 0 = no limit>
    procd_set_param respawn 3600 10 0
    procd_set_param stderr 1
    procd_close_instance
}
