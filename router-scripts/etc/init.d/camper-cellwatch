#!/bin/sh /etc/rc.common
# ============================================================
# SMART CAMPER - start-up file for the modem 3G watchdog   (v1)
# On the router (GL-X3000):  /etc/init.d/camper-cellwatch
#
# CHANGELOG
#   v1 - 2026-10-28. Runs /usr/bin/camper-cellwatch.sh (v1) as a procd
#        service: starts at boot (START=99), restarted by procd after 10 s
#        if it stops, no limit on retries. On stop procd sends TERM; the
#        script then puts the mode back to AUTO if a test was running.
#        Commands:  /etc/init.d/camper-cellwatch enable | start | stop
# ============================================================

START=99
STOP=10
USE_PROCD=1

start_service() {
    procd_open_instance
    procd_set_param command /usr/bin/camper-cellwatch.sh
    # respawn <reset counter after s> <wait before restart s> <max tries, 0 = no limit>
    procd_set_param respawn 3600 10 0
    procd_set_param stderr 1
    procd_close_instance
}
