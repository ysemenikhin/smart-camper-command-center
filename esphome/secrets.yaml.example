# Copy to secrets.yaml (gitignored) and fill in. Generate keys with:
#   openssl rand -base64 32
# ---- relay board (KC868-A16S, Ethernet) ----
relay_board_api_key: "REPLACE_WITH_BASE64_32_BYTES"
relay_board_ota_password: "only-needed-for-v2.0.x"
# DS18B20 ROM addresses - read them from the ESPHome log (one_wire scan)
ds18b20_clean_tank: 0x0000000000000000
ds18b20_grey_tank:  0x0000000000000000
ds18b20_pipe_1:     0x0000000000000000
ds18b20_pipe_2:     0x0000000000000000
# ---- air suspension (ESP32-S3, Wi-Fi) ----
api_encryption_key: "REPLACE_WITH_BASE64_32_BYTES"
wifi_ssid: "your-2.4GHz-ssid"
wifi_password: "your-wifi-password"
ap_ssid: "Camper-Air-Fallback"
ap_password: "change-me-8+chars"
# BLE MAC of the DN-3G manifold (nRF Connect or the ESPHome BLE tracker log)
manifold_mac: "00:00:00:00:00:00"
